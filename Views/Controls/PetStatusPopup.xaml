<UserControl x:Class="DesktopPet.Views.Controls.PetStatusPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Width="175">
    <Border Background="#F5FFFFFF" BorderBrush="#FF80AB" BorderThickness="1.5"
            CornerRadius="14" Padding="8,6"
            Effect="{DynamicResource ShadowEffect}">
        <StackPanel>
            <!-- TIÊU ĐỀ: TÊN + CẤP ĐỘ + NÚT ĐÓNG -->
            <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="11" Foreground="#37474F" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Border Grid.Column="1" Background="#FF4081" CornerRadius="8" Padding="5,1" Margin="4,0,4,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Level, StringFormat='Lv. {0}'}" FontWeight="Bold" FontSize="9" Foreground="White" />
                </Border>
                <Button Grid.Column="2" Click="OnCloseClick" ToolTip="Đóng bảng" Width="16" Height="16" Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="0" VerticalAlignment="Center">
                    <TextBlock Text="✕" FontSize="10" FontWeight="Bold" Foreground="#90A4AE" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Button>
            </Grid>

            <!-- THANH KINH NGHIỆM EXP -->
            <Grid Margin="0,0,0,6">
                <ProgressBar Value="{Binding ExpPercent, Mode=OneWay}" Height="4" Background="#ECEFF1" Foreground="#FF4081" BorderThickness="0">
                    <ProgressBar.Clip>
                        <RectangleGeometry Rect="0,0,158,4" RadiusX="2" RadiusY="2" />
                    </ProgressBar.Clip>
                </ProgressBar>
                <TextBlock Text="{Binding Exp, StringFormat='EXP: {0}'}" FontSize="8" Foreground="#78909C" HorizontalAlignment="Right" Margin="0,-10,0,0" />
            </Grid>

            <!-- CÁC CHỈ SỐ CƠ BẢN (LƯỚI 2 CỘT) -->
            <UniformGrid Columns="2" Rows="3" Margin="0,0,0,6">
                <!-- Máu -->
                <StackPanel Orientation="Horizontal" Margin="1,2">
                    <TextBlock Text="❤️" FontSize="11" Margin="0,0,3,0" />
                    <TextBlock Text="{Binding Health}" FontSize="10" FontWeight="SemiBold" Foreground="#424242" />
                </StackPanel>
                <!-- Đói -->
                <StackPanel Orientation="Horizontal" Margin="1,2">
                    <TextBlock Text="🍖" FontSize="11" Margin="0,0,3,0" />
                    <TextBlock Text="{Binding Hunger}" FontSize="10" FontWeight="SemiBold" Foreground="#424242" />
                </StackPanel>
                <!-- Hạnh phúc -->
                <StackPanel Orientation="Horizontal" Margin="1,2">
                    <TextBlock Text="😊" FontSize="11" Margin="0,0,3,0" />
                    <TextBlock Text="{Binding Happiness}" FontSize="10" FontWeight="SemiBold" Foreground="#424242" />
                </StackPanel>
                <!-- Năng lượng -->
                <StackPanel Orientation="Horizontal" Margin="1,2">
                    <TextBlock Text="⚡" FontSize="11" Margin="0,0,3,0" />
                    <TextBlock Text="{Binding Energy}" FontSize="10" FontWeight="SemiBold" Foreground="#424242" />
                </StackPanel>
                <!-- Vệ sinh -->
                <StackPanel Orientation="Horizontal" Margin="1,2">
                    <TextBlock Text="🧼" FontSize="11" Margin="0,0,3,0" />
                    <TextBlock Text="{Binding Cleanliness}" FontSize="10" FontWeight="SemiBold" Foreground="#424242" />
                </StackPanel>
                <!-- Thân thiết (Chill Bonding Stat) -->
                <StackPanel Orientation="Horizontal" Margin="1,2">
                    <TextBlock Text="💖" FontSize="11" Margin="0,0,3,0" />
                    <TextBlock Text="{Binding Affection, StringFormat='{}{0:0}%'}" FontSize="10" FontWeight="Bold" Foreground="#E91E63" />
                </StackPanel>
            </UniformGrid>

            <!-- HÀNG NÚT TƯƠNG TÁC NHANH -->
            <UniformGrid Columns="5" Margin="0,1,0,0">
                <!-- Cho ăn -->
                <Button Command="{Binding FeedCommand}" ToolTip="Cho ăn (🍖)" Margin="1" Padding="0,3"
                        Background="#FFF3E0" BorderBrush="#FFA726" BorderThickness="1.2" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6" />
                        </Style>
                    </Button.Resources>
                    <TextBlock Text="🍖" FontSize="13" />
                </Button>

                <!-- Chơi -->
                <Button Command="{Binding PlayCommand}" ToolTip="Chơi đùa (🎾)" Margin="1" Padding="0,3"
                        Background="#E8F5E9" BorderBrush="#66BB6A" BorderThickness="1.2" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6" />
                        </Style>
                    </Button.Resources>
                    <TextBlock Text="🎾" FontSize="13" />
                </Button>

                <!-- Tắm -->
                <Button Command="{Binding BathCommand}" ToolTip="Tắm rửa (🛁)" Margin="1" Padding="0,3"
                        Background="#E0F7FA" BorderBrush="#26C6DA" BorderThickness="1.2" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6" />
                        </Style>
                    </Button.Resources>
                    <TextBlock Text="🛁" FontSize="13" />
                </Button>

                <!-- Ngủ -->
                <Button Command="{Binding SleepToggleCommand}" ToolTip="Ngủ / Dậy (😴)" Margin="1" Padding="0,3"
                        Background="#EDE7F6" BorderBrush="#AB47BC" BorderThickness="1.2" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6" />
                        </Style>
                    </Button.Resources>
                    <TextBlock Text="😴" FontSize="13" />
                </Button>

                <!-- Túi đồ -->
                <Button x:Name="BagButton" Click="OnBagClick" ToolTip="Mở Túi Đồ (🎒)" Margin="1" Padding="0,3"
                        Background="#FCE4EC" BorderBrush="#EC407A" BorderThickness="1.2" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6" />
                        </Style>
                    </Button.Resources>
                    <TextBlock Text="🎒" FontSize="13" />
                </Button>
            </UniformGrid>
        </StackPanel>
    </Border>
</UserControl>
