<Window x:Class="DesktopPet.Views.ResetConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xác Nhận Xóa Dữ Liệu"
        Width="440" Height="220"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Border Background="#ECEFF1" BorderBrush="#EF5350" BorderThickness="3"
            CornerRadius="20" Padding="20" Effect="{DynamicResource WindowShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Tiêu đề cảnh báo -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="⚠️" FontSize="22" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="XÁC NHẬN XÓA DỮ LIỆU" FontSize="16" FontWeight="Bold" Foreground="#D32F2F" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Nội dung xác nhận -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock Text="Bạn có chắc muốn xóa toàn bộ dữ liệu game không?" 
                           FontWeight="Bold" FontSize="14" Foreground="#263238" TextWrapping="Wrap" Margin="0,0,0,8" />
                <TextBlock Text="Toàn bộ cấp độ, EXP, tiền và kho đồ sẽ được đặt lại. Hành động này không thể hoàn tác." 
                           FontSize="12" Foreground="#546E7A" TextWrapping="Wrap" LineHeight="18" />
            </StackPanel>

            <!-- Các nút hành động: Hủy và Xóa dữ liệu -->
            <Grid Grid.Row="2" Margin="0,15,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="15" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Click="OnCancelClick" Height="36"
                        Background="#CFD8DC" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="12" />
                        </Style>
                    </Button.Resources>
                    <TextBlock Text="HỦY" FontWeight="Bold" Foreground="#37474F" FontSize="12" />
                </Button>

                <Button Grid.Column="2" Click="OnConfirmClick" Height="36"
                        Background="#D32F2F" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="12" />
                        </Style>
                    </Button.Resources>
                    <TextBlock Text="XÓA DỮ LIỆU" FontWeight="Bold" Foreground="White" FontSize="12" />
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
