<Window x:Class="DesktopPet.Views.InventoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Túi Đồ Thú Cưng"
        Width="640" Height="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Border Background="#F9FBE7" BorderBrush="#8BC34A" BorderThickness="3"
            CornerRadius="22" Padding="20" Effect="{DynamicResource WindowShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- TIÊU ĐỀ + NÚT ĐÓNG -->
            <Grid Grid.Row="0" Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🎒" FontSize="26" Margin="0,0,8,0" />
                    <TextBlock Text="TÚI ĐỒ VÔ HẠN CỦA BẠN" FontSize="20" FontWeight="Bold" Foreground="#33691E" VerticalAlignment="Center" />
                    <Border Background="#DCEDC8" CornerRadius="10" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="🌿 Chill: Vật phẩm vô hạn ∞" FontSize="11" FontWeight="SemiBold" Foreground="#33691E" />
                    </Border>
                </StackPanel>

                <Button Click="OnCloseClick" HorizontalAlignment="Right" Width="32" Height="32"
                        Background="#FFEBEE" BorderBrush="#EF5350" BorderThickness="1.5"
                        Content="✕" FontWeight="Bold" Foreground="#D32F2F" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="16" />
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>

            <!-- THANH PHÂN LOẠI TAB (CATEGORIES) -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                <Button Content="Tất Cả" Command="{Binding SelectCategoryCommand}" CommandParameter="Tất Cả"
                        Margin="0,0,8,0" Padding="14,6" Background="#DCEDC8" FontWeight="SemiBold" Cursor="Hand" />
                <Button Content="🍖 Thức Ăn" Command="{Binding SelectCategoryCommand}" CommandParameter="Thức Ăn"
                        Margin="0,0,8,0" Padding="14,6" Background="#FFF3E0" FontWeight="SemiBold" Cursor="Hand" />
                <Button Content="🎾 Đồ Chơi" Command="{Binding SelectCategoryCommand}" CommandParameter="Đồ Chơi"
                        Margin="0,0,8,0" Padding="14,6" Background="#E8F5E9" FontWeight="SemiBold" Cursor="Hand" />
                <Button Content="🎩 Trang Phục" Command="{Binding SelectCategoryCommand}" CommandParameter="Trang Phục"
                        Padding="14,6" Background="#FCE4EC" FontWeight="SemiBold" Cursor="Hand" />
            </StackPanel>

            <!-- DANH SÁCH VẬT PHẨM TRONG TÚI -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="180" Height="170" Background="White" BorderBrush="#C5E1A5" BorderThickness="1.5"
                                    CornerRadius="16" Margin="6" Padding="10" Effect="{DynamicResource CardShadow}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Huy hiệu Đang Mặc góc trên trái -->
                                    <Border Grid.Row="0" HorizontalAlignment="Left" Background="#E91E63" CornerRadius="8" Padding="5,2"
                                            Visibility="{Binding ShowEquippedBadge, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="✓ Đang mặc" FontWeight="Bold" FontSize="10" Foreground="White" />
                                    </Border>

                                    <!-- Số lượng góc trên phải -->
                                    <Border Grid.Row="0" HorizontalAlignment="Right" Background="#689F38" CornerRadius="8" Padding="6,2">
                                        <TextBlock Text="{Binding QuantityDisplay}" FontWeight="Bold" FontSize="12" Foreground="White" />
                                    </Border>

                                    <!-- Icon + Tên -->
                                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,2,0,4">
                                        <TextBlock Text="{Binding Icon}" FontSize="34" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="#2E7D32"
                                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <!-- Mô tả -->
                                    <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="10" Foreground="#78909C"
                                               TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" MaxHeight="30" />

                                    <!-- Nút Sử Dụng / Mặc / Tháo Ra -->
                                    <Button Grid.Row="2" Command="{Binding DataContext.UseItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Height="30" Background="{Binding ButtonBackground}" BorderThickness="0" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="10" />
                                            </Style>
                                        </Button.Resources>
                                        <TextBlock Text="{Binding ActionText}" FontWeight="Bold" Foreground="White" FontSize="12" />
                                    </Button>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
