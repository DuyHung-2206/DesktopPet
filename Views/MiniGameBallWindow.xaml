<Window x:Class="DesktopPet.Views.MiniGameBallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Mini Game: Bắt Bóng"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        WindowState="Normal">

    <Canvas x:Name="GameCanvas">
        <!-- BẢNG ĐIỂM Ở GÓC TRÊN GIỮA MÀN HÌNH -->
        <Border Canvas.Left="20" Canvas.Top="20" Background="#E037474F" CornerRadius="18" Padding="18,10"
                BorderBrush="#FFD54F" BorderThickness="2">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🎯 BẮT BÓNG:" FontWeight="Bold" FontSize="16" Foreground="#FFD54F" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock x:Name="ScoreTextBlock" Text="0" FontWeight="Bold" FontSize="20" Foreground="White" VerticalAlignment="Center" Margin="0,0,20,0" />
                <TextBlock x:Name="TimeTextBlock" Text="Thời gian: 30s" FontWeight="SemiBold" FontSize="14" Foreground="#80DEEA" VerticalAlignment="Center" Margin="0,0,20,0" />
                <Button Click="OnEndGameClick" Content="Dừng Chơi ✕" Background="#D32F2F" Foreground="White" FontWeight="Bold" Padding="12,4" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10" />
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>

        <!-- QUẢ BÓNG NẢY (BALL) -->
        <Border x:Name="BallElement" Width="60" Height="60" CornerRadius="30"
                Background="#FFCA28" BorderBrush="#E65100" BorderThickness="2"
                Cursor="Hand" MouseLeftButtonDown="OnBallClick"
                Effect="{DynamicResource BallGlow}">
            <Grid>
                <TextBlock Text="⚽" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- THÔNG BÁO THẮNG / ĐIỂM THƯỞNG -->
        <Border x:Name="WinPanel" Canvas.Left="500" Canvas.Top="300" Background="#F0FFFFFF" BorderBrush="#4CAF50" BorderThickness="3"
                CornerRadius="20" Padding="30,20" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="🎉 XUẤT SẮC!" FontSize="24" FontWeight="Bold" Foreground="#2E7D32" HorizontalAlignment="Center" />
                <TextBlock x:Name="RewardSummaryText" Text="+100 🪙 &amp; +150 EXP!" FontSize="16" FontWeight="SemiBold" Foreground="#388E3C" Margin="0,10,0,15" HorizontalAlignment="Center" />
                <Button Click="OnEndGameClick" Content="Nhận Thưởng &amp; Đóng" Background="#4CAF50" Foreground="White" FontWeight="Bold" Padding="16,6" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="12" />
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>
    </Canvas>
</Window>
