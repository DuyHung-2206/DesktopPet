<Window x:Class="DesktopPet.Views.MainDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Desktop Pet World - Trung Tâm Điều Khiển"
        Width="820" Height="580"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Border Background="#FAFAFA" BorderBrush="#00BCD4" BorderThickness="3"
            CornerRadius="24" Padding="22" Effect="{DynamicResource WindowShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- TIÊU ĐỀ + VÍ TIỀN + NÚT ĐÓNG -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🌟" FontSize="28" Margin="0,0,8,0" />
                    <TextBlock Text="DESKTOP PET WORLD" FontSize="22" FontWeight="Bold" Foreground="#00838F" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#E8F5E9" BorderBrush="#81C784" BorderThickness="1.5" CornerRadius="14" Padding="14,6" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌿" FontSize="16" Margin="0,0,6,0" />
                            <TextBlock Text="Chill Mode: Đồ Ăn &amp; Đồ Chơi Vô Hạn ∞" FontWeight="Bold" FontSize="13" Foreground="#2E7D32" />
                        </StackPanel>
                    </Border>

                    <Button Click="OnCloseClick" Width="34" Height="34" Background="#FFEBEE" BorderBrush="#EF5350" BorderThickness="1.5"
                            Content="✕" FontWeight="Bold" Foreground="#D32F2F" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="17" />
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- NỘI DUNG CHÍNH (2 CỘT: TRÁI = PET & NÚT, PHẢI = ĐIỂM DANH & THÀNH TỰU) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- CỘT TRÁI: THẺ PET ĐANG NUÔI + NÚT ĐIỀU HƯỚNG -->
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <!-- Thẻ Pet -->
                    <Border Background="White" BorderBrush="#80DEEA" BorderThickness="2" CornerRadius="18" Padding="16" Margin="0,0,0,14" Effect="{DynamicResource CardShadow}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="{Binding PetVM.DisplayName}" FontWeight="Bold" FontSize="18" Foreground="#006064" />
                                <Border HorizontalAlignment="Right" Background="#FF4081" CornerRadius="10" Padding="8,2">
                                    <TextBlock Text="{Binding PetVM.Level, StringFormat='Level {0}'}" FontWeight="Bold" FontSize="12" Foreground="White" />
                                </Border>
                            </Grid>

                            <!-- Thanh EXP -->
                            <ProgressBar Value="{Binding PetVM.ExpPercent, Mode=OneWay}" Height="8" Background="#ECEFF1" Foreground="#FF4081" BorderThickness="0" Margin="0,0,0,12" />

                            <!-- 6 chỉ số -->
                            <UniformGrid Columns="2" Rows="3" Margin="0,0,0,6">
                                <TextBlock Text="{Binding PetVM.Health, StringFormat='❤️ Máu: {0}'}" FontSize="12" Margin="2,3" />
                                <TextBlock Text="{Binding PetVM.Hunger, StringFormat='🍖 No: {0}'}" FontSize="12" Margin="2,3" />
                                <TextBlock Text="{Binding PetVM.Happiness, StringFormat='😊 Vui: {0}'}" FontSize="12" Margin="2,3" />
                                <TextBlock Text="{Binding PetVM.Energy, StringFormat='⚡ Sức: {0}'}" FontSize="12" Margin="2,3" />
                                <TextBlock Text="{Binding PetVM.Cleanliness, StringFormat='🧼 Sạch: {0}'}" FontSize="12" Margin="2,3" />
                                <TextBlock Text="{Binding PetVM.Affection, StringFormat='💖 Thân: {0}'}" FontSize="12" Margin="2,3" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- CÁC NÚT ĐIỀU HƯỚNG LỚN -->
                    <UniformGrid Columns="2" Margin="0,0,0,6">
                        <Button Click="OnShopClick" Height="42" Margin="3" Background="#FFF3E0" BorderBrush="#FFA726" BorderThickness="1.5" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="12"/></Style></Button.Resources>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="🛒" FontSize="16" Margin="0,0,6,0"/><TextBlock Text="Cửa hàng" FontWeight="Bold" Foreground="#E65100"/></StackPanel>
                        </Button>
                        <Button Click="OnInventoryClick" Height="42" Margin="3" Background="#E8F5E9" BorderBrush="#66BB6A" BorderThickness="1.5" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="12"/></Style></Button.Resources>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="🎒" FontSize="16" Margin="0,0,6,0"/><TextBlock Text="Túi Đồ" FontWeight="Bold" Foreground="#2E7D32"/></StackPanel>
                        </Button>
                        <Button Click="OnCollectionClick" Height="42" Margin="3" Background="#F3E5F5" BorderBrush="#AB47BC" BorderThickness="1.5" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="12"/></Style></Button.Resources>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="🐾" FontSize="16" Margin="0,0,6,0"/><TextBlock Text="Bộ Sưu Tập" FontWeight="Bold" Foreground="#6A1B9A"/></StackPanel>
                        </Button>
                        <Button Click="OnSettingsClick" Height="42" Margin="3" Background="#ECEFF1" BorderBrush="#78909C" BorderThickness="1.5" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="12"/></Style></Button.Resources>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="⚙️" FontSize="16" Margin="0,0,6,0"/><TextBlock Text="Cài Đặt" FontWeight="Bold" Foreground="#37474F"/></StackPanel>
                        </Button>
                    </UniformGrid>
                </StackPanel>

                <!-- CỘT PHẢI: ĐIỂM DANH 7 NGÀY & DANH SÁCH THÀNH TỰU -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- KHU VỰC ĐIỂM DANH 7 NGÀY -->
                        <Border Background="White" BorderBrush="#FFD54F" BorderThickness="2" CornerRadius="18" Padding="14" Margin="0,0,0,14" Effect="{DynamicResource CardShadow}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="🎁 ĐIỂM DANH 7 NGÀY NHẬN QUÀ" FontWeight="Bold" FontSize="14" Foreground="#F57F17" />
                                    <Button Command="{Binding ClaimDailyRewardCommand}" HorizontalAlignment="Right" Background="#FF9800" Foreground="White"
                                            FontWeight="Bold" Padding="12,4" Cursor="Hand" Content="Nhận Quà Ngay!">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                                    </Button>
                                </Grid>
                                <TextBlock Text="{Binding DailyRewardStatusText}" FontSize="11" Foreground="#78909C" Margin="0,0,0,8" />

                                <!-- 7 ngày hiển thị ngang -->
                                <ItemsControl ItemsSource="{Binding DailyRewards}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="7" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#FFFDE7" BorderBrush="#FFE082" BorderThickness="1.5" CornerRadius="12" Margin="2" Padding="4">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding DayNumber, StringFormat='Ngày {0}'}" FontSize="10" FontWeight="SemiBold" Foreground="#E65100" HorizontalAlignment="Center" />
                                                    <TextBlock Text="{Binding Icon}" FontSize="20" HorizontalAlignment="Center" Margin="0,2" />
                                                    <TextBlock Text="{Binding RewardSummary}" FontSize="9" TextAlignment="Center" TextWrapping="Wrap" Foreground="#5D4037" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- KHU VỰC NHIỆM VỤ HÀNG NGÀY (SHORT QUESTS) -->
                        <Border Background="White" BorderBrush="#81C784" BorderThickness="2" CornerRadius="18" Padding="14" Margin="0,0,0,14" Effect="{DynamicResource CardShadow}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="🎯 NHIỆM VỤ HÀNG NGÀY" FontWeight="Bold" FontSize="14" Foreground="#2E7D32" />
                                    <TextBlock HorizontalAlignment="Right" Text="Thưởng: Xu + EXP + Vật Phẩm" FontSize="11" Foreground="#4CAF50" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Quests}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E8F5E9" BorderThickness="0,0,0,1" Padding="0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="36" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="22" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="12" Foreground="#263238" />
                                                            <TextBlock Text="{Binding ProgressText, StringFormat=' ({0})'}" FontSize="11" Foreground="#546E7A" FontWeight="SemiBold" Margin="4,0,0,0" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Description}" FontSize="10" Foreground="#78909C" />
                                                        <TextBlock Text="{Binding RewardText, StringFormat='🎁 Thưởng: {0}'}" FontSize="10" Foreground="#2E7D32" FontWeight="SemiBold" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <Button Grid.Column="2" VerticalAlignment="Center"
                                                            Command="{Binding DataContext.ClaimQuestCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Content="{Binding ButtonText}"
                                                            Background="{Binding ButtonBackground}"
                                                            Foreground="White"
                                                            FontWeight="Bold"
                                                            FontSize="11"
                                                            Padding="10,4"
                                                            Cursor="Hand"
                                                            IsEnabled="{Binding CanClaim}">
                                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- KHU VỰC THÀNH TỰU (ACHIEVEMENTS) -->
                        <Border Background="White" BorderBrush="#B0BEC5" BorderThickness="2" CornerRadius="18" Padding="14" Effect="{DynamicResource CardShadow}">
                            <StackPanel>
                                <TextBlock Text="🏆 DANH HIỆU &amp; THÀNH TỰU" FontWeight="Bold" FontSize="14" Foreground="#37474F" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding Achievements}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#ECEFF1" BorderThickness="0,0,0,1" Padding="0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="20" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0">
                                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="12" Foreground="#263238" />
                                                        <TextBlock Text="{Binding Description}" FontSize="10" Foreground="#78909C" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding RewardExp, StringFormat='+{0} EXP'}" FontSize="11" FontWeight="Bold" Foreground="#7B1FA2" HorizontalAlignment="Right" />
                                                        <TextBlock Text="{Binding IsUnlocked, Converter={StaticResource BooleanToStatusTextConverter}}" FontSize="10" Foreground="#4CAF50" HorizontalAlignment="Right" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
