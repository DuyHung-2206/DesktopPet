<Window x:Class="DesktopPet.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Cài Đặt Trò Chơi"
        Width="500" Height="460"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Border Background="#ECEFF1" BorderBrush="#607D8B" BorderThickness="3"
            CornerRadius="22" Padding="20" Effect="{DynamicResource WindowShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- TIÊU ĐỀ + NÚT ĐÓNG -->
            <Grid Grid.Row="0" Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚙️" FontSize="24" Margin="0,0,8,0" />
                    <TextBlock Text="CÀI ĐẶT TRÒ CHƠI" FontSize="18" FontWeight="Bold" Foreground="#263238" VerticalAlignment="Center" />
                </StackPanel>

                <Button Click="OnCloseClick" HorizontalAlignment="Right" Width="32" Height="32"
                        Background="#FFEBEE" BorderBrush="#EF5350" BorderThickness="1.5"
                        Content="✕" FontWeight="Bold" Foreground="#D32F2F" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="16" />
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>

            <!-- NỘI DUNG CÀI ĐẶT -->
            <StackPanel Grid.Row="1">
                <!-- Âm thanh -->
                <Border Background="White" CornerRadius="12" Padding="14,10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="🔊 ÂM LƯỢNG &amp; HIỆU ỨNG" FontWeight="Bold" FontSize="13" Foreground="#455A64" Margin="0,0,0,6" />
                        <Grid Margin="0,2,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="45" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Âm lượng:" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding SoundVolume}" SmallChange="0.05" LargeChange="0.1" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding SoundVolumeText}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#455A64" Margin="6,0,0,0" />
                        </Grid>
                        <CheckBox Content="Tắt toàn bộ âm thanh (Mute)" IsChecked="{Binding IsMuted}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- Kích thước & Màn hình -->
                <Border Background="White" CornerRadius="12" Padding="14,10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="🖥️ KÍCH THƯỚC &amp; MÀN HÌNH" FontWeight="Bold" FontSize="13" Foreground="#455A64" Margin="0,0,0,6" />
                        <Grid Margin="0,2,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Kích thước Pet:" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding ScaleOptions}" SelectedItem="{Binding SelectedScale}" />
                        </Grid>
                        <Grid Margin="0,2,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Chọn màn hình:" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding MonitorOptions}" SelectedIndex="{Binding SelectedMonitorIndex}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Hệ thống & Hiệu năng -->
                <Border Background="White" CornerRadius="12" Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="⚡ HỆ THỐNG &amp; KHỞI ĐỘNG" FontWeight="Bold" FontSize="13" Foreground="#455A64" Margin="0,0,0,6" />
                        <CheckBox Content="📌 Luôn nổi trên các cửa sổ khác (Always on top)" IsChecked="{Binding AlwaysOnTop}" Margin="0,3" />
                        <CheckBox Content="🔔 Bật thông báo nhắc nhở khi đói / mệt" IsChecked="{Binding NotificationsEnabled}" Margin="0,3" />
                        <CheckBox Content="🚀 Khởi động cùng Windows" IsChecked="{Binding StartWithWindows}" Margin="0,3" />
                        <CheckBox Content="🍃 Chế độ tiết kiệm pin &amp; giảm CPU" IsChecked="{Binding PerformanceMode}" Margin="0,3" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- NÚT LƯU CÀI ĐẶT -->
            <Button Grid.Row="2" Command="{Binding SaveSettingsCommand}" Height="36" Margin="0,15,0,0"
                    Background="#546E7A" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="14" />
                    </Style>
                </Button.Resources>
                <TextBlock Text="LƯU CÀI ĐẶT" FontWeight="Bold" Foreground="White" FontSize="13" />
            </Button>
        </Grid>
    </Border>
</Window>
