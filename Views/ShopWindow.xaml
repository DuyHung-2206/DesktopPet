<Window x:Class="DesktopPet.Views.ShopWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Cửa Hàng Thú Cưng"
        Width="680" Height="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Border Background="#FFFDF7" BorderBrush="#FFA726" BorderThickness="3"
            CornerRadius="22" Padding="20" Effect="{DynamicResource WindowShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- TIÊU ĐỀ + CHILL BADGE + NÚT ĐÓNG -->
            <Grid Grid.Row="0" Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🍳" FontSize="26" Margin="0,0,8,0" />
                    <TextBlock Text="BẾP ĂN &amp; CỬA HÀNG CHO BÉ" FontSize="20" FontWeight="Bold" Foreground="#E65100" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Huy hiệu Chill Mode -->
                    <Border Background="#E8F5E9" BorderBrush="#81C784" BorderThickness="1.5" CornerRadius="14" Padding="12,5" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌿" FontSize="15" Margin="0,0,5,0" />
                            <TextBlock Text="Chill Mode: Miễn Phí Vô Hạn ∞" FontWeight="Bold" FontSize="13" Foreground="#2E7D32" />
                        </StackPanel>
                    </Border>

                    <!-- Nút Đóng -->
                    <Button Click="OnCloseClick" Width="32" Height="32" Background="#FFEBEE" BorderBrush="#EF5350" BorderThickness="1.5"
                            Content="✕" FontWeight="Bold" Foreground="#D32F2F" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="16" />
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- THANH PHÂN LOẠI TAB (CATEGORIES) -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                <Button Content="Tất Cả" Command="{Binding SelectCategoryCommand}" CommandParameter="Tất Cả"
                        Margin="0,0,8,0" Padding="14,6" Background="#FFE082" FontWeight="SemiBold" Cursor="Hand" />
                <Button Content="🍖 Thức Ăn" Command="{Binding SelectCategoryCommand}" CommandParameter="Thức Ăn"
                        Margin="0,0,8,0" Padding="14,6" Background="#FFF3E0" FontWeight="SemiBold" Cursor="Hand" />
                <Button Content="🎾 Đồ Chơi" Command="{Binding SelectCategoryCommand}" CommandParameter="Đồ Chơi"
                        Padding="14,6" Background="#E8F5E9" FontWeight="SemiBold" Cursor="Hand" />
            </StackPanel>

            <!-- DANH SÁCH VẬT PHẨM (ITEMS LIST) -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding DisplayItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="195" Height="185" Background="White" BorderBrush="#FFE082" BorderThickness="1.5"
                                    CornerRadius="16" Margin="6" Padding="10" Effect="{DynamicResource CardShadow}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Icon + Tên -->
                                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,2,0,4">
                                        <TextBlock Text="{Binding Icon}" FontSize="36" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="#37474F"
                                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <!-- Mô tả & Chỉ số cộng -->
                                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatsPreview}" FontSize="11" FontWeight="SemiBold" Foreground="#43A047"
                                                   TextAlignment="Center" Margin="0,0,0,2" />
                                        <TextBlock Text="{Binding Description}" FontSize="10" Foreground="#78909C"
                                                   TextAlignment="Center" TextWrapping="Wrap" MaxHeight="30" />
                                    </StackPanel>

                                    <!-- Nút Cho Bé Dùng -->
                                    <Button Grid.Row="2" Command="{Binding DataContext.BuyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Height="32" Background="#4CAF50" BorderThickness="0" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="12" />
                                            </Style>
                                        </Button.Resources>
                                        <TextBlock Text="✨ Cho Bé Dùng (∞)" FontWeight="Bold" Foreground="White" FontSize="12" HorizontalAlignment="Center" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
